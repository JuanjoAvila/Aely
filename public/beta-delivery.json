98a327b3f1e71904fb05361041d379372404127a8994c2f0cc5f278db","vibracion-r5":"0a89976686ed49083107e64ef54a23e121398f74200d66ca8c6aa036c337832f","vibracion-r6":"c593bef1b4c32413c571860a63fdde63835b1dc183e4aa407cd6275e15fa0820","vibracion-suave-ronda-2":"9bdb86684728a82405ef72a02dd0cccda6f0633a5f7b8e705bfabe5c837915df","vibracion-suave-ronda-3":"8a32b5c28f0ceae24b3d23776ad9039996e97e3c5ea1c5fdaadbc27f7900be30","vuelta-sin-tiron":"8535cc7c32e36a3c534f3e88d815b4bb2a1f7dc29a048a9f21fcc0b08f7c9a10","widget-app-cerrada":"21dea9bd4f4bbd45d665c6994881e7069008f386151c72808bffe26e60f41ebf","widget-banco":"b9814c11e73845106489ce765ab99be8764f6102bfdd80c9919bc98a5e9257d8","widget-ciclo-puente":"21dea9bd4f4bbd45d665c6994881e7069008f386151c72808bffe26e60f41ebf","widget-pago-app-cerrada":"21dea9bd4f4bbd45d665c6994881e7069008f386151c72808bffe26e60f41ebf","widget-pasado-del-limite":"680bc99b80b0b13411b44599cb62c5f3cd464f3e90a137b35bc9d06640eeb7b7","widget-se-actualiza-solo":"680bc99b80b0b13411b44599cb62c5f3cd464f3e90a137b35bc9d06640eeb7b7","youtube-diagnostico":"e3eeae691aac5d645de55cb2d8592aa7b7eb8951f16e74d9f380d66961e1c3bc","youtube-enlazar-recibo":"dd6a544d43d38d493c073ac7e766258b2b33d7011e348fcbb753cb537a29d87c","youtube-ficha-reconoce":"e3eeae691aac5d645de55cb2d8592aa7b7eb8951f16e74d9f380d66961e1c3bc","youtube-r4":"e3eeae691aac5d645de55cb2d8592aa7b7eb8951f16e74d9f380d66961e1c3bc"},"pruebas":{"teclado-241":{"v":"4.26.241","contenido":"[\"teclado-241\",\"Apuntar: el concepto con el teclado del móvil\",[\"1. Apuntar (el botón + de abajo): toca el concepto y escribe algo; después oculta el teclado con su flecha o con el botón Atrás del móvil, sin tocar «Listo». BIEN: mientras sale el teclado la hoja sube con él, pegada, y entre la hoja y el teclado no asoma nada de lo que hay detrás (ni Gastos ni la barra de abajo); al ocultarlo, la hoja vuelve entera, con la forma de pago, el teclado de números y el botón «Apuntar», sin caerse ni rebotar, y puedes volver a tocar el concepto. MAL: el teclado tapa las categorías, asoma la pantalla de detrás o la barra de abajo, la hoja da un salto o rebota, o se queda recogida sin teclado.\",\"2. Vuelve a tocar el concepto, escribe y toca «Listo»; hazlo dos veces seguidas. BIEN: la hoja acompaña al teclado sin saltos (la primera vez en este móvil puede esperar al teclado y subir al final; desde la segunda va a la par); no queda hueco entre el concepto y «Listo» ni teclas cortadas; al tocar «Listo» vuelven la forma de pago, el teclado de números y la baldosa del banco (su logo, o un «+» si no hay ninguno elegido), y el botón dice «Apuntar». MAL: la segunda vez sigue habiendo salto, queda un hueco o algo cortado, o tras «Listo» algo se queda montado o falta la baldosa del banco.\"],1]"},"diseno-240":{"v":"4.26.240","contenido":"[\"diseno-240\",\"Deudas, Metas, Ajustes y Perfil\",[\"1. Plan → Deudas y después Plan → Metas: mira la tarjeta de arriba y cada fila. BIEN: arriba hay una tarjeta como la de Recibos, con la cifra grande a la izquierda; cada deuda y cada meta lleva su nombre entero y, si no le cabe al lado, la cifra baja entera a la línea de abajo; ya no está la frase de debajo de las deudas ni el emoji en «Amortizar ahora»; una deuda con un familiar (mamá, papá, un amigo…) lleva icono de persona; en Metas, si no apartas nada al mes, sale «Ahorro mensual · Añadir» en una sola fila. MAL: la cifra de arriba se parte, un nombre o una cifra salen cortados con «…», o sigue el texto de relleno.\",\"2. Ajustes (la rueda de arriba): recorre todas las filas y abre Accesibilidad; luego toca tu foto de arriba para abrir «Tu perfil». BIEN: cada fila tiene su propio icono dibujado, sin emojis ni dos iguales; el botón de volver es redondo; la «?» de ayuda está junto al buscador; «Reducir animaciones», «Más contraste» y «Ciclo de cobro» van sin frase debajo, y tampoco hay frase bajo «Tamaño de letra»; en «Tu perfil», «Hogar compartido» va en una línea e «Ir a Ajustes» es una fila con flecha. MAL: falta un icono, hay dos iguales o un emoji, sigue alguna frase debajo, o una fila no abre lo de siempre.\",\"3. Ajustes → Accesibilidad → Tamaño de letra: elige «Enorme» y mira Plan → Deudas, Plan → Metas y Ajustes; después vuelve a dejar la letra como la tenías. BIEN: nada sale cortado con «…» ni con una palabra partida por la mitad; los nombres y las cifras se leen enteros, aunque bajen de línea. MAL: algún texto se corta, una palabra se parte, o algo se sale de su tarjeta.\"],1]"},"dinero-238":{"v":"4.26.238","contenido":"[\"dinero-238\",\"Cuentas de recibos: cada recibo se resta una vez\",[\"1. Cartera: mira el saldo de cada una de tus cuentas de recibos y compáralo con el de tu banco (o con el que veías ayer). Después abre Plan → Recibos y, arriba, «¿Te llega?» de ese banco. BIEN: cada cuenta tiene el mismo saldo que ayer si no ha habido movimientos; en Recibos cada recibo sale una sola vez; «Tienes hoy» es la suma de lo que ves en Cartera para las cuentas de ese banco; si tienes dos cuentas de recibos en el mismo banco, un recibo ya pagado se resta una sola vez. MAL: una cuenta ha cambiado de saldo sin movimientos, un recibo sale dos veces, o «Tienes hoy» no cuadra con Cartera.\"],1]"}},"referenciasHistoricas":{"inc-0810-inicio-grafica-significado":{"sha":"f4ffb9340adfd0a13b631271e8158d2c630613c0","version":"4.26.109","codigo":"b90e6223cd45ef64e8689d4c772560c31c7db47939694211a892316030a283f0","web":"d05bb0d4d86dce14c5ba4794a0be2a265e52f3a167cf8eadce87aa198e5cd38d","estado":"ausente"}}}