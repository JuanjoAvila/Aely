<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Edge-to-edge: la WebView pinta bajo status/nav; el color lo pone el CSS (bg + safe-area). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- ⚠⚠ LA CAUSA DE VERDAD, encontrada el 2026-08-01 tras su pushback («Revolut no le pasa
             lo mismo, así que no es cosa de Android» — y tenía razón, no era el sistema operativo
             en general, era ESTA APP). `androidx.core:core-splashscreen` está en build.gradle,
             pero `SplashScreen.installSplashScreen()` NUNCA se llamaba en MainActivity, y aquí
             solo se ponía `android:background` — un atributo LEGACY que el sistema de splash de
             Android 12+ (`Theme.SplashScreen`, el mismo parent de este tema) NO lee. Sin
             `windowSplashScreenBackground`/`windowSplashScreenAnimatedIcon`, Android 12+ dibuja
             SU PROPIO splash genérico (color y icono derivados por defecto, sin nuestro diseño)
             durante el arranque, y SOLO DESPUÉS entra el bundle web con el splash de verdad
             (`#mc-load` en shell.html) — dos pantallas de splash seguidas, y la primera no es la
             nuestra. Eso es el «algo raro antes de aparecer el icono, como apagado» que llevaba
             reportando desde hace días: no es un efecto, es un SPLASH DISTINTO que no controlamos.
             Revolut/TR no lo tienen porque configuraron estos atributos; aquí no se habían tocado.
             `android:background` se queda como red de seguridad para el Android<12 que sirve el
             `minSdkVersion` (23): ahí SÍ se sigue leyendo (comportamiento clásico de windowBackground). -->
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/splash_bg_green</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <!-- ⚠ SIN ESTO (2026-08-06): tras el splash Android NO cambia al tema sin ActionBar.
             En su Oppo quedaba una franja nativa bajo la cámara (ActionBar / chrome del
             Theme.SplashScreen) encima de la WebView — la «ralla gigante» que no era temática
             ni batería. postSplashScreenTheme es el eslabón que pide la lib de splash. -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- Sigue siendo una mitigación honesta, no una garantía, para el resto de lo reportado:
             el atenuado al REANUDAR desde el multitarea (no al ARRANCAR en frío) puede seguir
             siendo la animación propia del selector de apps de MIUI/HyperOS, ajena a esta app. -->
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- UX-03: el splash salía siempre verde oscuro y luego la app cambiaba a su tema (con el claro,
         un fogonazo oscuro→claro en cada arranque). El tema lo guarda MainActivity al irse la app
         al fondo; en Android 13+ el sistema recuerda el splash elegido para el siguiente arranque
         (`setSplashScreenTheme`) y en Android 6-11 lo aplica la librería al arrancar. Android 12
         (API 31-32) no deja cambiarlo: ahí sigue saliendo el verde. Solo cambia el fondo; el icono
         lo pone Android y no se puede redecorar (saga de 2026-08-03). El tema verde es el de arriba. -->
    <style name="AppTheme.NoActionBarLaunch.Dark">
        <item name="android:background">@color/splash_bg_dark</item>
        <item name="windowSplashScreenBackground">@color/splash_bg_dark</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch.Light">
        <item name="android:background">@color/splash_bg_light</item>
        <item name="windowSplashScreenBackground">@color/splash_bg_light</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch.Blue">
        <item name="android:background">@color/splash_bg_blue</item>
        <item name="windowSplashScreenBackground">@color/splash_bg_blue</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch.Cyber">
        <item name="android:background">@color/splash_bg_cyber</item>
        <item name="windowSplashScreenBackground">@color/splash_bg_cyber</item>
    </style>
</resources>