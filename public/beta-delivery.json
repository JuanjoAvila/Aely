b8dc54e7e29028ea","widget-ciclo-puente":"8d7231579969c68cf6f0a65e33357b3d85805c2eca15f3a1bd8dd04f0fa0d658","widget-pago-app-cerrada":"8d7231579969c68cf6f0a65e33357b3d85805c2eca15f3a1bd8dd04f0fa0d658"},"pruebas":{"bancos-acuse-reconexion":{"v":"4.26.119","contenido":"[\"bancos-acuse-reconexion\",\"Bancos: nada se pierde si falla la conexión o al reconectar\",[\"1. En Cartera, dentro de «Tus cuentas», toca el icono «Sincronizar bancos» y espera a que termine. Abre Gastos: los movimientos nuevos de tus bancos aparecen, cada uno una sola vez, sin repetidos.\",\"2. Vuelve a Cartera y toca «Sincronizar bancos» otra vez: en Gastos no aparece ningún movimiento repetido. Toca el icono «Conectar cuentas» para abrir «Mis bancos»: en cada banco, la línea «Saldo actualizado» marca la hora de ahora.\",\"3. Abre Aely con tu cuenta en otro dispositivo o en el navegador del ordenador y sincroniza los bancos allí. Vuelve al móvil y sincroniza: no falta ningún movimiento y ninguno sale repetido. Si no tienes otro dispositivo a mano, deja este paso sin probar.\",\"4. Para probar la reconexión (ahora, o cuando un banco te caduque): en «Mis bancos», toca un banco, pulsa «Reconectar» y autoriza la misma cuenta de siempre. Al volver a la app, toca «Sincronizar bancos»: en Gastos no falta ningún día entre la última vez y hoy, y no hay movimientos repetidos. Si no reconectas ningún banco, deja este paso sin probar.\"],1]"}},"referenciasHistoricas":{"inc-0810-inicio-grafica-significado":{"sha":"f4ffb9340adfd0a13b631271e8158d2c630613c0","version":"4.26.109","codigo":"b90e6223cd45ef64e8689d4c772560c31c7db47939694211a892316030a283f0","web":"d05bb0d4d86dce14c5ba4794a0be2a265e52f3a167cf8eadce87aa198e5cd38d","estado":"ausente"}}}