7","widget-se-actualiza-solo":"680bc99b80b0b13411b44599cb62c5f3cd464f3e90a137b35bc9d06640eeb7b7","youtube-diagnostico":"c95c4ed638b836f63b3f81b116c83cb853c74bf0a44746e75da19030e00a4c68","youtube-enlazar-recibo":"761cea6468b2e3e8ab34c1031c4c8bd06ee7fec87a5c1027832b93591a6ce21f","youtube-ficha-reconoce":"c95c4ed638b836f63b3f81b116c83cb853c74bf0a44746e75da19030e00a4c68","youtube-r4":"c95c4ed638b836f63b3f81b116c83cb853c74bf0a44746e75da19030e00a4c68"},"pruebas":{"barra-gastos-carga":{"v":"4.26.197","contenido":"[\"barra-gastos-carga\",\"Gastos: la barra de abajo al cargar más\",[\"1. Gastos › Movimientos: baja con el dedo, sin soltar, hasta que cargue más movimientos. BIEN: la barra de abajo sigue escondida hasta que subas. MAL: reaparece sola mientras bajas.\"],1]"},"tr-login-v2":{"v":"4.26.196","contenido":"[\"tr-login-v2\",\"Ajustes: conectar Trade Republic\",[\"1. Instala la app nueva cuando te lo pida. Después: Ajustes › Conectar un banco › Trade Republic › teléfono y PIN › Conectar. BIEN: te pide aprobar el inicio de sesión en la app de Trade Republic (o escribir el código) y, al hacerlo, queda conectado y trae tus posiciones. MAL: sale un error y no conecta.\"],1]"},"fin28-aviso-enlace-manual":{"v":"4.26.195","contenido":"[\"fin28-aviso-enlace-manual\",\"Gastos: vincular un cargo a un recibo\",[\"1. Gastos → abre un cargo que no sea de un recibo → «Paga un recibo» → elige uno pendiente. BIEN: pide «Confirmar pago completo»; al confirmar, el recibo queda pagado y el cargo conserva su importe y su banco; «Deshacer vínculo» devuelve el recibo a pendiente. MAL: no deja vincular, o el cargo cambia de importe o de banco.\",\"2. Solo si tienes dos recibos del mismo importe en el mismo banco con cargos a pocos días de diferencia: vincula el segundo cargo al segundo recibo. BIEN: avisa «Puede ser el mismo cargo que …» y solo sigue con «Es otro pago»; cancelar no cambia nada. MAL: vincula sin avisar un cargo que ya paga otro recibo, o avisa sin que haya otro cargo igual. Si no tienes un caso así, salta este paso.\"],1]"},"plan-recibos-t3":{"v":"4.26.194","contenido":"[\"plan-recibos-t3\",\"Plan: ¿te llega el dinero?\",[\"1. Plan → Recibos → toca la píldora «Te llega» o «Falta …». BIEN: sale «¿Te llega?» con un bloque por cada banco que tiene recibos en «Pendiente»; «Tienes hoy» es el saldo que ves en Cartera para ese banco y «Recibos que faltan» suma lo de «Pendiente» de ese banco. MAL: falta o sobra un banco, o las cifras no cuadran con Cartera o con «Pendiente».\",\"2. En esa hoja, mira si algún banco tiene la fila «Pagado, aún sin restar del saldo». BIEN: si sale, es un recibo que ya está en «Ya pagados» pero cuyo cobro el saldo del banco todavía no recoge. Un recibo cobrado hoy sale ahí hasta que se lea el saldo de ese banco otro día, y eso es normal; la cifra grande es «Tienes hoy» menos todas las filas. MAL: la cifra no sale de restar las filas, o sale un recibo que no está en «Ya pagados».\",\"3. En la hoja → «¿Y si gasto…?» → toca «Importe» y escribe 50. BIEN: la cifra grande de ese banco baja justo 50 y la línea dice «Llega · te quedan …» o «No llega · faltan …» con esa cifra; al borrar, vuelve a la de antes. MAL: baja otra cantidad o cambia otro banco.\"],1]"}},"referenciasHistoricas":{"inc-0810-inicio-grafica-significado":{"sha":"f4ffb9340adfd0a13b631271e8158d2c630613c0","version":"4.26.109","codigo":"b90e6223cd45ef64e8689d4c772560c31c7db47939694211a892316030a283f0","web":"d05bb0d4d86dce14c5ba4794a0be2a265e52f3a167cf8eadce87aa198e5cd38d","estado":"ausente"}}}