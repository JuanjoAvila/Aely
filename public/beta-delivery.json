","widget-banco":"a110dfb0bde90bffc5eda127861b2dd1d68ddf1fa19a9554825eba4f9547a510","widget-ciclo-puente":"350e924e30226fc97c4904b8fd1f554dccf592d0794d378112cd8703c69cf70e","widget-pago-app-cerrada":"350e924e30226fc97c4904b8fd1f554dccf592d0794d378112cd8703c69cf70e"},"pruebas":{"deudas-plazo-cuota-encaja":{"v":"4.26.139","contenido":"[\"deudas-plazo-cuota-encaja\",\"Deudas: la cuota tiene que encajar con el plazo\",[\"1. Abre Plan, pestaña Deudas, y toca una deuda que tenga plazo («Quedan X/Y cuotas») y sin intereses. Baja la cuota y toca «Guardar cambios»: sale el aviso de que no encajan y dice «Con N cuotas por pagar, la cuota tiene que estar entre A y B»; no se guarda.\",\"2. Pon una cuota dentro de ese rango y guarda: sale «Cambios guardados» y la tarjeta muestra el «Quedan X/Y cuotas» nuevo.\",\"3. Abre otra vez la deuda, pon la cuota a 0 y guarda: avisa de que con saldo pendiente la cuota no puede ser 0 y no guarda. Nota: si la deuda tiene intereses, bajar la cuota sí se guarda porque solo cambia lo que pagas, no lo que amortiza.\"],1]"},"deudas-metas-hoja-sin-parpadeo":{"v":"4.26.139","contenido":"[\"deudas-metas-hoja-sin-parpadeo\",\"Deudas y Metas: la hoja de editar abre sin parpadeo\",[\"1. Abre Plan, pestaña Deudas, y toca una deuda: la hoja sube suave desde abajo, el fondo se oscurece poco a poco y nada parpadea ni salta.\",\"2. Cierra con el gesto de atrás del sistema: se cierra la hoja y sigues en Plan.\",\"3. Haz lo mismo en la pestaña Metas con una meta.\"],1]"}},"referenciasHistoricas":{"inc-0810-inicio-grafica-significado":{"sha":"f4ffb9340adfd0a13b631271e8158d2c630613c0","version":"4.26.109","codigo":"b90e6223cd45ef64e8689d4c772560c31c7db47939694211a892316030a283f0","web":"d05bb0d4d86dce14c5ba4794a0be2a265e52f3a167cf8eadce87aa198e5cd38d","estado":"ausente"}}}