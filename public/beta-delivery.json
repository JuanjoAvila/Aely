o-puente":"9ee683d02d6de3029964e30c1fd160b764e2cc31f06c8829e9accbb9aaacd862","widget-pago-app-cerrada":"9ee683d02d6de3029964e30c1fd160b764e2cc31f06c8829e9accbb9aaacd862","widget-pasado-del-limite":"680bc99b80b0b13411b44599cb62c5f3cd464f3e90a137b35bc9d06640eeb7b7","widget-se-actualiza-solo":"680bc99b80b0b13411b44599cb62c5f3cd464f3e90a137b35bc9d06640eeb7b7","youtube-diagnostico":"aa64acd3d1e98c93881fb851acdf65438c16e1afaf58b231b824d8dcdfcb4b2e","youtube-enlazar-recibo":"1da2aad37e51e5ce1095a70f3eff0025e449b2ec7beb71600214ddb5750c3e15","youtube-ficha-reconoce":"aa64acd3d1e98c93881fb851acdf65438c16e1afaf58b231b824d8dcdfcb4b2e","youtube-r4":"aa64acd3d1e98c93881fb851acdf65438c16e1afaf58b231b824d8dcdfcb4b2e"},"pruebas":{"gastos-filtros-icono":{"v":"4.26.200","contenido":"[\"gastos-filtros-icono\",\"Gastos: botón de filtros con deslizadores\",[\"1. Gastos, junto al buscador. BIEN: un botón redondo con un icono de deslizadores, sin emoji y sin número mientras no hay filtros. MAL: sigue el emoji o sale un número sin haber puesto nada.\",\"2. Toca el botón → elige un banco o un tipo de movimiento → Ver. BIEN: el botón se marca y un globito dice cuántos filtros llevas; con Restablecer el globito desaparece. MAL: el globito dice otro número, no aparece o se queda tras restablecer.\"],1]"},"plan-recibos-t4":{"v":"4.26.199","contenido":"[\"plan-recibos-t4\",\"Plan: añadir y editar recibos por pasos\",[\"1. Plan → Recibos → Todos → «+» → escribe un nombre (o toca una sugerencia) → importe → día → banco → Añadir recibo. BIEN: cinco pasos con su barra; el primer número que tecleas sustituye; deslizar a la derecha vuelve un paso; al terminar sale en Pendiente con su importe y «Queda por pagar» sube justo eso. MAL: se crea dos veces, falta un paso o la cifra de arriba sube otra cantidad.\",\"2. Toca un recibo aún sin pagar → Editar → Importe → otro importe → Listo → «Solo octubre» → Guardar. BIEN: este mes sale con el importe nuevo; vuelve a Editar y el importe del recibo sigue siendo el de siempre (el mes que viene vuelve a lo normal). MAL: cambia también otros meses o la cifra de arriba no cuadra.\",\"3. En un recibo que ya está en «Ya pagados» → Editar → cambia el importe → Guardar. BIEN: no pregunta; sigue en «Ya pagados» con lo que se pagó y no sale en «Para revisar». MAL: vuelve a Pendiente, cambia lo pagado o aparece «cobró distinto».\"],1]"}},"referenciasHistoricas":{"inc-0810-inicio-grafica-significado":{"sha":"f4ffb9340adfd0a13b631271e8158d2c630613c0","version":"4.26.109","codigo":"b90e6223cd45ef64e8689d4c772560c31c7db47939694211a892316030a283f0","web":"d05bb0d4d86dce14c5ba4794a0be2a265e52f3a167cf8eadce87aa198e5cd38d","estado":"ausente"}}}