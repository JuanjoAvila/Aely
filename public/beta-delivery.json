6686ed49083107e64ef54a23e121398f74200d66ca8c6aa036c337832f","vibracion-r6":"c593bef1b4c32413c571860a63fdde63835b1dc183e4aa407cd6275e15fa0820","vibracion-suave-ronda-2":"9bdb86684728a82405ef72a02dd0cccda6f0633a5f7b8e705bfabe5c837915df","vibracion-suave-ronda-3":"8a32b5c28f0ceae24b3d23776ad9039996e97e3c5ea1c5fdaadbc27f7900be30","vuelta-sin-tiron":"18104b6e40dd02ccc26b73f7c9f1a7932c69728eb0c9978766a2817ef5a18131","widget-app-cerrada":"308ce87460cf73b25c6b1be0aea4432a185595b33dc41ba8e81f3f2a5ed75065","widget-banco":"d64ad3e54cd568cfb6a702fbaeb64aed090f1f2610adcf30c148cf3bfee617c8","widget-ciclo-puente":"308ce87460cf73b25c6b1be0aea4432a185595b33dc41ba8e81f3f2a5ed75065","widget-pago-app-cerrada":"308ce87460cf73b25c6b1be0aea4432a185595b33dc41ba8e81f3f2a5ed75065","widget-pasado-del-limite":"680bc99b80b0b13411b44599cb62c5f3cd464f3e90a137b35bc9d06640eeb7b7","widget-se-actualiza-solo":"680bc99b80b0b13411b44599cb62c5f3cd464f3e90a137b35bc9d06640eeb7b7","youtube-diagnostico":"6c4ea6405726c9131471df2c39f5883925f66d1dc7c54b8dd1acdc7f5d5a0da8","youtube-enlazar-recibo":"aa5b151502fd1bc41d77518387841ed7cc1807df58548a14fc8eeaca825c0cc8","youtube-ficha-reconoce":"6c4ea6405726c9131471df2c39f5883925f66d1dc7c54b8dd1acdc7f5d5a0da8","youtube-r4":"6c4ea6405726c9131471df2c39f5883925f66d1dc7c54b8dd1acdc7f5d5a0da8"},"pruebas":{"diseno-240":{"v":"4.26.240","contenido":"[\"diseno-240\",\"Deudas, Metas, Ajustes y Perfil\",[\"1. Plan → Deudas y después Plan → Metas: mira la tarjeta de arriba y cada fila. BIEN: arriba hay una tarjeta como la de Recibos, con la cifra grande a la izquierda; cada deuda y cada meta lleva su nombre entero y, si no le cabe al lado, la cifra baja entera a la línea de abajo; ya no está la frase de debajo de las deudas ni el emoji en «Amortizar ahora»; una deuda con un familiar (mamá, papá, un amigo…) lleva icono de persona; en Metas, si no apartas nada al mes, sale «Ahorro mensual · Añadir» en una sola fila. MAL: la cifra de arriba se parte, un nombre o una cifra salen cortados con «…», o sigue el texto de relleno.\",\"2. Ajustes (la rueda de arriba): recorre todas las filas y abre Accesibilidad; luego toca tu foto de arriba para abrir «Tu perfil». BIEN: cada fila tiene su propio icono dibujado, sin emojis ni dos iguales; el botón de volver es redondo; la «?» de ayuda está junto al buscador; «Reducir animaciones», «Más contraste» y «Ciclo de cobro» van sin frase debajo, y tampoco hay frase bajo «Tamaño de letra»; en «Tu perfil», «Hogar compartido» va en una línea e «Ir a Ajustes» es una fila con flecha. MAL: falta un icono, hay dos iguales o un emoji, sigue alguna frase debajo, o una fila no abre lo de siempre.\",\"3. Ajustes → Accesibilidad → Tamaño de letra: elige «Enorme» y mira Plan → Deudas, Plan → Metas y Ajustes; después vuelve a dejar la letra como la tenías. BIEN: nada sale cortado con «…» ni con una palabra partida por la mitad; los nombres y las cifras se leen enteros, aunque bajen de línea. MAL: algún texto se corta, una palabra se parte, o algo se sale de su tarjeta.\"],1]"},"concepto-239":{"v":"4.26.239","contenido":"[\"concepto-239\",\"Apuntar: escribir el concepto con el teclado\",[\"1. Apuntar (el botón + de abajo): toca el concepto y escribe uno largo, por ejemplo «Cena de cumpleaños con los primos en el restaurante del puerto»; después toca «Listo». BIEN: al salir el teclado la hoja se recoge a la vez, el concepto queda a la vista justo encima del teclado y «Listo» pegado a él, sin un hueco vacío entre los dos; el texto largo baja entero a un segundo renglón, sin «…»; las categorías se ven en filas enteras; al tocar «Listo» vuelven la forma de pago y el teclado de números y el botón vuelve a decir «Apuntar». MAL: el concepto queda tapado o se sale por arriba, hay un hueco vacío entre el concepto y «Listo», el texto se corta con «…», una fila de categorías sale a medias, o tras «Listo» algo queda montado o fuera de su sitio.\",\"2. En esa misma hoja, con Tarjeta o Bizum, mira la baldosa del banco junto a la forma de pago y tócala. BIEN: si hay banco elegido sale su logo; si no, sale un hueco punteado con «+»; al tocarla aparecen tus bancos para elegir. MAL: sale un cuadro vacío, un logo que no es el de tu banco, o al tocarla no pasa nada.\"],1]"},"dinero-238":{"v":"4.26.238","contenido":"[\"dinero-238\",\"Cuentas de recibos: cada recibo se resta una vez\",[\"1. Cartera: mira el saldo de cada una de tus cuentas de recibos y compáralo con el de tu banco (o con el que veías ayer). Después abre Plan → Recibos y, arriba, «¿Te llega?» de ese banco. BIEN: cada cuenta tiene el mismo saldo que ayer si no ha habido movimientos; en Recibos cada recibo sale una sola vez; «Tienes hoy» es la suma de lo que ves en Cartera para las cuentas de ese banco; si tienes dos cuentas de recibos en el mismo banco, un recibo ya pagado se resta una sola vez. MAL: una cuenta ha cambiado de saldo sin movimientos, un recibo sale dos veces, o «Tienes hoy» no cuadra con Cartera.\"],1]"}},"referenciasHistoricas":{"inc-0810-inicio-grafica-significado":{"sha":"f4ffb9340adfd0a13b631271e8158d2c630613c0","version":"4.26.109","codigo":"b90e6223cd45ef64e8689d4c772560c31c7db47939694211a892316030a283f0","web":"d05bb0d4d86dce14c5ba4794a0be2a265e52f3a167cf8eadce87aa198e5cd38d","estado":"ausente"}}}