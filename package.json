{
  "name": "aely",
  "version": "4.26.34",
  "private": true,
  "description": "Aely — PWA de finanzas personales (+ envoltorio Android con Capacitor)",
  "scripts": {
    "build": "node scripts/build-app.mjs",
    "build:sentry": "node scripts/bundle-sentry.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:relevant": "node scripts/relevant-tests.mjs --git && node scripts/run-tests.mjs --plan relevant-plan.json",
    "test:syntax": "node scripts/check-syntax.mjs",
    "test:privacy": "node scripts/guard-privacy.mjs",
    "test:e2e": "npx playwright test --config=playwright.config.mjs",
    "stamp": "node scripts/stamp-version.mjs",
    "memoria": "node scripts/sync-memoria.mjs",
    "errores": "node scripts/errores.mjs",
    "sugerencias": "node scripts/errores.mjs --kind=feedback --limit=50",
    "apk:prep": "node scripts/guard-webdebug.mjs && node scripts/build-app.mjs && node scripts/build-www.mjs && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "release:apk": "node scripts/release-apk.mjs",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "salud": "node scripts/salud.mjs",
    "listo": "node scripts/listo-para-produccion.mjs",
    "servidor": "node scripts/servidor-al-dia.mjs",
    "logos": "node scripts/logos-bancos.mjs",
    "logos:inv": "node scripts/logos-inversiones.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.1.0",
    "@capgo/capacitor-updater": "^6.50.1",
    "@sentry/browser": "^9.47.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@iconify-json/logos": "^1.2.14",
    "@playwright/test": "^1.52.0",
    "esbuild": "^0.25.5",
    "pngjs": "^7.0.0",
    "simple-icons": "^16.30.0"
  }
}
